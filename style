* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background-color: #f4f4f4;
}

header {
    background: #333;
    color: white;
    padding: 1rem;
    text-align: center;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 2rem;
}

nav a {
    color: white;
    text-decoration: none;
}

main {
    padding: 2rem;
}

#search {
    background: white;
    padding: 2rem;
    border-radius: 5px;
    margin-bottom: 2rem;
    text-align: center;
}

#car-search {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    max-width: 800px;
    margin: 0 auto;
}

#car-search select,
#car-search input,
#car-search button {
    padding: 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
}

#car-search button {
    background: #007bff;
    color: white;
    border: none;
    cursor: pointer;
}

.car-card {
    background: white;
    border-radius: 5px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.car-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 5px;
}

footer {
    text-align: center;
    padding: 1rem;
    background: #333;
    color: white;
}
